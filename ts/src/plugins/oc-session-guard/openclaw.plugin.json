{
  "id": "oc-session-guard",
  "name": "OC Session Guard",
  "description": "Session bloat management & idle admission guard — strips bloat fields, purges stale subagents, and blocks idle model calls. No sidecar needed.",
  "contracts": {
    "tools": ["session_health", "session_cleanup"],
    "hooks": ["after_compaction", "session_end", "before_agent_run"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxAgeHours": { "type": "number", "default": 15 },
      "stripBloatFields": { "type": "boolean", "default": true },
      "suppressIdleHeartbeats": {
        "type": "boolean",
        "default": true,
        "description": "Block automated heartbeat turns when no actionable tasks are due to prevent idle model calls"
      },
      "bloatFields": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["compactionCheckpoints", "systemPromptReport", "skillsSnapshot", "contextBudgetStatus", "usageFamilySessionIds", "lastHeartbeatText"]
      },
      "sessionsPath": { "type": "string", "description": "Override path to sessions.json" }
    }
  }
}
