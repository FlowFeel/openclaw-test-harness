{
  "id": "oc-subagent-watchdog",
  "name": "OC Subagent Watchdog",
  "description": "Tracks subagent lifecycle — spawn/ended events, stale detection, active count limits. No sidecar needed.",
  "contracts": {
    "tools": ["subagent_health"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxConcurrent": { "type": "number", "default": 6 },
      "runTimeoutSeconds": { "type": "number", "default": 300 },
      "staleCheckIntervalMs": { "type": "number", "default": 60000 }
    }
  }
}
