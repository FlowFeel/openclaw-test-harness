{
  "id": "oc-model-router",
  "name": "OC Model Router",
  "description": "Model fallback chain optimization — tracks per-model latency and error rates, routes calls to the fastest healthy model.",
  "contracts": {
    "tools": ["model_health"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "p99ThresholdMs": { "type": "number", "default": 15000 },
      "errorRateThreshold": { "type": "number", "default": 0.1 },
      "minSamples": { "type": "number", "default": 5 }
    }
  }
}