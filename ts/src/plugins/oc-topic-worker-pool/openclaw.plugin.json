{
  "id": "oc-topic-worker-pool",
  "name": "OcTopicWorkerPool",
  "description": "Hook-based worker pool with semaphore admission control for concurrent Telegram topic sessions",
  "contracts": {
    "hooks": [
      "before_dispatch",
      "before_agent_run",
      "agent_end",
      "subagent_spawning",
      "subagent_ended",
      "before_agent_reply",
      "session_end"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "mainPoolMax": { "type": "number", "default": 3 },
      "subPoolMax": { "type": "number", "default": 2 },
      "dedupWindowMs": { "type": "number", "default": 5000 },
      "acquireTimeoutMs": { "type": "number", "default": 10000 },
      "maxLeaseDurationMs": { "type": "number", "default": 300000 },
      "watchdogIntervalMs": { "type": "number", "default": 30000 }
    }
  }
}
