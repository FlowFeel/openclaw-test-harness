{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": [
      "node",
      "vitest/globals"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
// tests/oc-source and ../oc-source are excluded from the harness tsc program:
// the submodule is the OpenClaw fork compiled with ITS OWN tsconfig. Under the
// harness's strict settings the fork source produces ~16k errors (TS18046 etc.)
// and plain tsc cannot resolve @openclaw/* (only vitest aliases can, at
// runtime). oc-source specs are runtime-verified in the E2E layer (90/90).
  "exclude": [
    "node_modules",
    "dist",
    "oc-source",
    "../oc-source",
    "tests/oc-source"
  ]
}