{
  "name": "openclaw-test-harness-ts",
  "version": "0.1.0",
  "description": "TypeScript test harness for OpenClaw modifications — Effect Schema, XState v5, Vitest, Playwright",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "gate": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@effect/schema": "^0.75.0",
    "@xstate/react": "^5.0.0",
    "better-sqlite3": "^13.0.2",
    "effect": "^3.0.0",
    "xstate": "^5.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
