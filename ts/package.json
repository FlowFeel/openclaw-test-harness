{
  "name": "openclaw-test-harness-ts",
  "version": "0.1.0",
  "description": "TypeScript test harness for OpenClaw modifications — Effect Schema, XState v5, Vitest, Playwright",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:plugins": "node scripts/build-plugins.mjs",
    "test:e2e": "vitest run tests/e2e/ tests/oc-source/ --reporter=verbose --testTimeout=120000 --minWorkers=1 --maxWorkers=1",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "validate:foundry": "for d in src/plugins/oc-*/; do npx tsx src/foundry/cli.ts validate \"$d\" || exit 1; done",
    "lint": "eslint src/ tests/",
    "gate": "npm run typecheck && npm run validate:foundry && npm run lint && npm run test"
  },
  "dependencies": {
    "@effect/schema": "^0.75.0",
    "@xstate/react": "^5.0.0",
    "better-sqlite3": "^11.0.0",
    "effect": "3.12.0",
    "piscina": "^5.3.0",
    "sql.js": "^1.14.1",
    "xstate": "^5.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@openclaw/fs-safe": "^0.5.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.0.0",
    "json5": "^2.2.3",
    "kysely": "^0.29.5",
    "patch-package": "^8.0.0",
    "string-width": "^8.2.2",
    "testcontainers": "^10.18.0",
    "tslog": "^5.1.0",
    "tsx": "^4.19.0",
    "typebox": "^1.3.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "2.1.9",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.62.4"
  }
}
